-lines=3D"3" data-author-content=3D"app.UseSwagger(options =3D>
{
    options.SerializeAsV2 =3D true;
});
"><span>app.UseSwagger(options =3D&gt;
{</span>
<mark>    options.SerializeAsV2 =3D <span class=3D"hljs-literal">true</span=
>;</mark>
