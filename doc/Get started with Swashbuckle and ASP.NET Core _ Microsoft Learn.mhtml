				</span>
			</div>
		</button>
	</div><pre class=3D"has-inner-focus"><code class=3D"lang-csharp" highlight=
-lines=3D"4" data-author-content=3D"builder.Services.AddControllers();

builder.Services.AddEndpointsApiExplorer();
